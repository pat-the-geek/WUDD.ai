SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Remise à zéro explicite des quotas chaque jour à 00h01
# Force reset_day() même si le processus n'a pas appelé _maybe_reset_day à minuit
1 0 * * * root cd /app && python3 -c "from utils.quota import get_quota_manager; get_quota_manager().reset_day(); print('[quota] Remise à zéro des quotas journaliers OK')" 2>&1 | tee -a /app/rapports/cron_quota_reset.log

# Surveillance round-robin des flux RSS WUDD.opml : 1 flux par exécution, toutes les 5 minutes
# Maintient 48-heures.json à jour, puis rafraîchit la timeline et les temps de lecture (calculs locaux, < 1 s)
*/5 * * * * root cd /app && { python3 scripts/flux_watcher.py 2>&1 | tee -a /app/rapports/cron_flux_watcher.log; python3 scripts/entity_timeline.py >> /app/rapports/cron_flux_watcher.log 2>&1; python3 scripts/enrich_reading_time.py >> /app/rapports/cron_flux_watcher.log 2>&1; }
# Analyse croisée des flux : une fois par jour à 6h30 — rapports/markdown/_WUDD.AI_/cross_flux_YYYY-MM-DD.md
30 6 * * * root cd /app && python3 scripts/cross_flux_analysis.py 2>&1 | tee -a /app/rapports/cron_cross_flux.log
# Surveillance des sources web sans RSS (sitemap) : toutes les 2h — max 5 articles par source par run
# Complète 48-heures.json et data/articles-from-rss/ de façon isolée, sans impacter le pipeline RSS
0 */2 * * * root cd /app && python3 scripts/web_watcher.py 2>&1 | tee -a /app/rapports/cron_web_watcher.log
# Exécution de get-keyword-from-rss.py toutes les 2h de 6h00 à 22h00 (6,8,10,12,14,16,18,20,22)
# (reconstruit 48-heures.json intégralement — filet de sécurité + enrichissement sur toute la fenêtre 7j)
0 6-22/2 * * * root cd /app && python3 scripts/get-keyword-from-rss.py 2>&1 | tee -a /app/rapports/cron_get_keyword.log
# Veille horaire (7h–22h) : notifie sur Discord le dernier article fraîchement
# détecté mentionnant une entité surveillée (grande image + résumé). Au plus
# 1 article/heure et 1 notification par entité et par jour ; articles promo écartés.
0 7-22 * * * root cd /app && python3 scripts/watch_entity_articles.py 2>&1 | tee -a /app/rapports/cron_watch_articles.log
# Vérification automatique du cron toutes les 10 minutes
*/10 * * * * root cd /app && python3 scripts/check_cron_health.py 2>&1 | tee -a /app/rapports/cron_health.log
# Exécute le scheduler chaque lundi à 6h du matin
0 6 * * 1 root cd /app && python3 scripts/scheduler_articles.py 2>&1 | tee -a /app/rapports/cron_scheduler.log
# Génère le radar thématique le dernier jour du mois à 5h00
0 5 28-31 * * root [ "$(date -d tomorrow +\%d)" = "01" ] && cd /app && python3 scripts/radar_wudd.py 2>&1 | tee -a /app/rapports/cron_radar.log
# Convertit les articles-from-rss en Markdown (nouveau format) le dernier jour du mois à 5h30
# DÉSACTIVÉ 2026-03-31 : génère des doublons avec generate_keyword_reports.py (format Keyword_rapport_YYYY-MM-DD.md)
# 30 5 28-31 * * root [ "$(date -d tomorrow +\%d)" = "01" ] && cd /app && python3 scripts/articles_rss_to_markdown.py 2>&1 | tee -a /app/rapports/cron_rss_markdown.log
# Génère le rapport quotidien Top 10 entités des 48h à 23h00 (après la dernière collecte RSS de 22h00)
# DÉSACTIVÉ 2026-06-04 : rapport rapport_48h.md jugé inutile par l'utilisateur
# 0 23 * * * root cd /app && python3 scripts/generate_48h_report.py 2>&1 | tee -a /app/rapports/cron_48h_report.log
# Détecte les tendances et génère data/alertes.json — matin (7h00) et midi (12h00).
# Le cooldown (global.cooldown_days) évite de re-notifier les mêmes entités ;
# le run de midi ne notifie donc que les entités réellement nouvelles ou escaladées.
0 7 * * * root cd /app && python3 scripts/trend_detector.py 2>&1 | tee -a /app/rapports/cron_trends.log
0 12 * * * root cd /app && python3 scripts/trend_detector.py 2>&1 | tee -a /app/rapports/cron_trends.log
# Morning Digest quotidien à 7h30 (30 min après trend_detector pour avoir alertes.json à jour)
30 7 * * * root cd /app && python3 scripts/generate_morning_digest.py --ai 2>&1 | tee -a /app/rapports/cron_morning_digest.log
# Notes de lecture quotidiennes à 8h00 (articles des 24h par tag, dans rapports/markdown/_WUDD.AI_/)
0 8 * * * root cd /app && python3 scripts/generate_reading_notes.py 2>&1 | tee -a /app/rapports/cron_reading_notes.log
# Rapport de consommation IA quotidien à 8h15 — ajoute dans rapports/markdown/_MORNING_DIGEST_/ai_consumption_report.md
# Agrège articles traités (quota_state + quota_history 7j) + tokens parsés depuis les logs cron
15 8 * * * root cd /app && python3 scripts/generate_ai_consumption_report.py 2>&1 | tee -a /app/rapports/cron_ai_consumption.log
# Backup des données : data/ → BACKUP_L1 → BACKUP_L2 chaque nuit à 1h00
# (avant les enrichissements NER/sentiment, après la dernière collecte de la veille)
0 1 * * * root cd /app && python3 scripts/backup_data.py 2>&1 | tee -a /app/rapports/cron_backup.log

# Enrichissement NER Round-Robin : 1 fichier/source par jour à 2h00
# Ajoute le champ "entities" aux articles qui n'en ont pas encore (tous les répertoires data/)
0 2 * * * root cd /app && python3 scripts/enrich_entities.py 2>&1 | tee -a /app/rapports/cron_enrich_entities.log
# Reconstruction autoritative de l'index articles à 2h40 — après enrich_entities (2h00)
# et enrich_images (2h30), juste avant precompute (2h45) : garantit un index complet
# et déterministe (ne dépend plus du timing de rebuild au démarrage du viewer).
# rebuild() est protégé (report fichiers illisibles + anti-rétrécissement < 50%).
40 2 * * * root cd /app && python3 scripts/migrate_build_indexes.py --only article 2>&1 | tee -a /app/rapports/cron_rebuild_index.log
# Pré-calcul des stats d'entités (entity_stats.json) à 2h45 — après le rebuild d'index
# Alimente le cache chaud de api_entities_dashboard() pour le viewer
45 2 * * * root cd /app && python3 scripts/precompute_entity_stats.py 2>&1 | tee -a /app/rapports/cron_precompute_entity_stats.log
# Enrichissement images : fetch og:image pour les articles sans images à 2h30
# Parcourt data/articles/ et data/articles-from-rss/ — aucun appel IA, fetch HTTP uniquement
30 2 * * * root cd /app && python3 scripts/enrich_images.py 2>&1 | tee -a /app/rapports/cron_enrich_images.log
# Enrichissement sentiment Round-Robin : 1 fichier/source par jour à 3h00
# Tourne sur tous les fichiers data/articles-from-rss/ ET data/articles/<flux>/ de façon cyclique
0 3 * * * root cd /app && python3 scripts/enrich_sentiment.py 2>&1 | tee -a /app/rapports/cron_sentiment.log
# Enrichissement Résumé_md (Markdown) Round-Robin à 3h30 — ajoute le résumé formaté
# (chapitres ###, gras/italique) pour l'affichage enrichi. Reformatage local (Ollama),
# plafonné à 150 reformatages/run. Le champ Résumé brut reste inchangé.
30 3 * * * root cd /app && python3 scripts/enrich_summary_format.py --max-articles 150 2>&1 | tee -a /app/rapports/cron_summary_format.log
# Réparation des résumés en erreur : chaque dimanche à 4h00 (maintenance hebdomadaire)
# Régénère les articles dont le Résumé contient un message d'erreur API EurIA
0 4 * * 0 root cd /app && python3 scripts/repair_failed_summaries.py 2>&1 | tee -a /app/rapports/cron_repair.log
# Réparation des enrichissements NER/sentiment en échec : chaque dimanche à 4h30
30 4 * * 0 root cd /app && python3 scripts/repair_failed_enrichments.py --type all 2>&1 | tee -a /app/rapports/cron_repair_enrichments.log
# Synchronisation du registre des sources : chaque dimanche à 3h30
# Ajoute dans sources_credibility.json les nouvelles sources détectées dans OPML, web_sources.json
# et les articles existants — aucun appel HTTP externe, exécution rapide (< 10 s)
30 3 * * 0 root cd /app && python3 scripts/enrich_source_credibility.py --sync-only 2>&1 | tee -a /app/rapports/cron_enrich_credibility.log
# Enrichissement crédibilité sources (WHOIS + transparence + MBFC) : mensuel, 1er du mois à 4h30
# --sync : synchronise d'abord le registre, puis enrichit les sources manquantes de données v2
30 4 1 * * root cd /app && python3 scripts/enrich_source_credibility.py --sync 2>&1 | tee -a /app/rapports/cron_enrich_credibility.log

# ─── Système auto-apprenant ────────────────────────────────────────────────────
# Archive l'état des quotas du jour précédent dans data/quota_history/YYYY-MM-DD.json
# (doit s'exécuter après le reset à 00h01, avant le prochain enregistrement)
5 0 * * * root cd /app && python3 scripts/archive_quota_state.py 2>&1 | tee -a /app/rapports/cron_archive_quota.log
# Mise à jour des scores de qualité des articles dans article_index.json
# Exécuté à 4h00 (après backup à 1h, NER à 2h, images à 2h30, sentiment à 3h)
0 4 * * * root cd /app && python3 scripts/update_quality_scores.py 2>&1 | tee -a /app/rapports/cron_quality_scores.log
# Calibration automatique des seuils d'alerte (après trend_detector à 7h00)
15 7 * * * root cd /app && python3 scripts/calibrate_alerts.py 2>&1 | tee -a /app/rapports/cron_calibrate_alerts.log
# Optimisation hebdomadaire des poids de scoring (chaque lundi à 5h30)
30 5 * * 1 root cd /app && python3 scripts/optimize_scoring_weights.py 2>&1 | tee -a /app/rapports/cron_scoring_weights.log
# Optimisation hebdomadaire des quotas journaliers (chaque lundi à 5h45)
45 5 * * 1 root cd /app && python3 scripts/optimize_quota.py 2>&1 | tee -a /app/rapports/cron_optimize_quota.log
# Détection de dérive des mots-clés : dernier jour du mois à 5h15 (avant radar_wudd à 5h00)
15 5 28-31 * * root [ "$(date -d tomorrow +\%d)" = "01" ] && cd /app && python3 scripts/keyword_drift_detector.py 2>&1 | tee -a /app/rapports/cron_keyword_drift.log
# Performance empirique des sources : mensuel, 1er du mois à 4h45
45 4 1 * * root cd /app && python3 scripts/update_source_performance.py 2>&1 | tee -a /app/rapports/cron_source_performance.log
# Briefing exécutif hebdomadaire : chaque lundi à 6h30 (après trend_detector du lundi matin)
# Synthèse IA : top entités, articles scorés, tendances — rapports/markdown/_BRIEFING_/
30 6 * * 1 root cd /app && python3 scripts/generate_briefing.py --period weekly 2>&1 | tee -a /app/rapports/cron_briefing.log
# Rapports mensuels par mot-clé : dernier jour du mois à 6h00
# Génère un rapport Markdown par fichier data/articles-from-rss/ pour la période courante
0 6 28-31 * * root [ "$(date -d tomorrow +\%d)" = "01" ] && cd /app && python3 scripts/generate_keyword_reports.py 2>&1 | tee -a /app/rapports/cron_keyword_reports.log
# Export Obsidian quotidien : DÉSACTIVÉ (charge trop le vault)
# 30 8 * * * root cd /app && python3 scripts/export_obsidian.py --days 7 2>&1 | tee -a /app/rapports/cron_export_obsidian.log

# Rapport hebdomadaire entités surveillées : lundi 8h45 après l'export Obsidian
45 8 * * 1 root cd /app && python3 scripts/generate_watched_report.py 2>&1 | tee -a /app/rapports/cron_watched_report.log
# Suivi santé sources : quotidien 6h45 (avant les rapports du matin)
45 6 * * * root cd /app && python3 scripts/check_source_health.py 2>&1 | tee -a /app/rapports/cron_source_health.log
# Digest personnalisé par profil : quotidien 8h20 (après les enrichissements)
20 8 * * * root cd /app && python3 scripts/generate_personal_digest.py 2>&1 | tee -a /app/rapports/cron_personal_digest.log

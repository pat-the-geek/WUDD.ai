# ==============================================================================
# Configuration pour l'analyse d'actualités - TEMPLATE
# ==============================================================================
# 
# Instructions :
# 1. Copier ce fichier en .env : cp .env.example .env
# 2. Remplacer les valeurs d'exemple par vos vraies credentials
# 3. Ne JAMAIS commiter le fichier .env sur GitHub !
#
# ==============================================================================

# Fournisseur IA actif : "euria" (défaut) ou "claude"
AI_PROVIDER=euria

# Configuration API Infomaniak EurIA (Qwen3) — requis si AI_PROVIDER=euria
# --------------------------------------------------------------------------
# Endpoint de l'API d'intelligence artificielle Infomaniak (compatible OpenAI)
# Par défaut pour EurIA : https://api.infomaniak.com/2/ai/VOTRE_ID/openai/v1/chat/completions
URL=https://api.infomaniak.com/2/ai/VOTRE_PRODUCT_ID/openai/v1/chat/completions

# Token d'authentification Bearer pour l'API EurIA
# Obtenir depuis : Manager Infomaniak > Produits IA > API
bearer=VOTRE_TOKEN_BEARER_ICI

# Configuration API Anthropic Claude — requis si AI_PROVIDER=claude
# -----------------------------------------------------------------
# Clé API Anthropic (obtenir sur https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modèle pour les tâches batch (résumé, NER, sentiment) — par défaut Haiku
CLAUDE_MODEL_BATCH=claude-haiku-4-5-20251001
# Modèle pour les synthèses user-facing (rapport, RAG, encyclopédique) — par défaut Sonnet
CLAUDE_MODEL_SYNTHESIS=claude-sonnet-4-6

# Paramètres de gestion d'erreurs
# --------------------------------
# Nombre maximal de tentatives en cas d'échec de requête API
MAX_RETRIES=3

# Timeout pour les requêtes API (en secondes)
TIMEOUT_RESUME=60
TIMEOUT_RAPPORT=300

# ==============================================================================
# Nouvelles fonctionnalités v2.2 — Exports et notifications
# ==============================================================================

# Newsletter SMTP (optionnel — laisser vide pour désactiver)
# -----------------------------------------------------------
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Webhooks sortants (optionnel — laisser vide pour désactiver)
# -------------------------------------------------------------
# Discord : URL du webhook (Paramètres serveur > Intégrations > Webhooks)
WEBHOOK_DISCORD=

# Slack : URL du webhook entrant (api.slack.com > Incoming Webhooks)
WEBHOOK_SLACK=

# Ntfy.sh : URL de notification push (ex: https://ntfy.sh/votre-topic)
NTFY_URL=
# Token Ntfy si votre topic est privé (laisser vide si public)
NTFY_TOKEN=

# ==============================================================================
# Backup des données (optionnel)
# ==============================================================================
# Répertoires de backup pour data/ — chemins absolus sur la machine hôte
# IMPORTANT (Docker) : montez ces répertoires comme volumes dans docker-compose.yml
#   volumes:
#     - /votre/backup-L1:/backup-L1
#     - /votre/backup-L2:/backup-L2
# puis utilisez les chemins DANS le conteneur (/backup-L1, /backup-L2)
# Backup L1 : destination principale (copie directe de data/)
BACKUP_L1=
# Backup L2 : copie secondaire (miroir de L1, effectuée avant la copie data→L1)
BACKUP_L2=

# ==============================================================================
# Contrôle d'accès au Viewer WUDD.ai (optionnel)
# ==============================================================================
# Mot de passe unique pour protéger l'interface web (laisser vide = accès libre)
# Si défini, une page de connexion est affichée avant tout accès au viewer.
ACCESS_PASSWORD=

# Clé secrète pour les sessions Flask (recommandé en production)
# Si laissé vide, une clé aléatoire est générée à chaque redémarrage
# (les sessions sont perdues au redémarrage — définir cette valeur pour persistance)
SECRET_KEY=

# Liste d'adresses IP autorisées sans mot de passe (séparées par des virgules)
# Ex: ALLOWED_IPS=192.168.1.10,192.168.1.20
# Ces IPs peuvent accéder directement même si ACCESS_PASSWORD est défini.
ALLOWED_IPS=

# Proxies de confiance dont l'en-tête X-Forwarded-For est accepté (séparés par des virgules)
# À n'utiliser que si le viewer est derrière un reverse proxy connu (nginx, Traefik…)
# Ex: TRUSTED_PROXIES=127.0.0.1,172.17.0.1
# Sans cette variable, seul request.remote_addr est utilisé (recommandé pour usage direct)
TRUSTED_PROXIES=

# ==============================================================================
# Export Obsidian (optionnel)
# ==============================================================================
# Répertoire cible pour l'export des rapports vers Obsidian — chemin absolu
# IMPORTANT (Docker) : montez ce répertoire comme volume dans docker-compose.yml
#   volumes:
#     - /votre/vault-obsidian:/obsidian
# puis utilisez le chemin DANS le conteneur (/obsidian)
OBSIDIAN_DIR=
# Nom exact du vault Obsidian tel qu'il apparaît dans l'interface Obsidian.
# Utilisé pour construire les liens obsidian://open?vault=...&file=...
# Si laissé vide, les liens s'ouvrent dans le dernier vault actif (recommandé
# si vous n'avez qu'un seul vault ou si OBSIDIAN_DIR pointe vers sa racine).
# Attention : le nom du vault peut différer du nom du répertoire.
OBSIDIAN_VAULT_NAME=
